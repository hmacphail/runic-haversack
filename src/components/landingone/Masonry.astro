---
import Entries from "../entries/Entries.astro";
import { getFeaturedItems } from "../../pages/featured-items.json.js"
const resp = await getFeaturedItems();
const featuredItems = await resp.json();
const items = featuredItems.map((featItem) => featItem.item_data);
const mainItem = items.splice(0, 1)[0];
---
<section>
  <div class="2xl:max-w-7xl max-w-6xl md:px-12 mx-auto px-8 pt-6 pb-10">
    <div class="mb-6">
      {
        <Entries
          title={mainItem.name}
          description={mainItem.description_plaintext}
          url={mainItem.ecom_uri}
          images={mainItem.ecom_image_uris}
          variations={mainItem.variations}
          isMain={true}
        />
      }
    </div>
    <div class="grid gap-4 grid-cols-1 lg:gap-y-8 lg:grid-cols-2">
      {
        items.map((item) => (
          <Entries
            title={item.name}
            description={item.description_plaintext}
            url={item.ecom_uri}
            images={item.ecom_image_uris}
            variations={item.variations}
            isMain={false}
          />
        ))
      }
    </div>
  </div>
</section>
---
import { Icon } from 'astro-icon/components'
---

<footer style="background: linear-gradient(135deg, #b2afe4 0%, #4840a0 100%);">
  <div class="mx-auto my-7 w-full justify-center">
    <div
        class="mx-auto w-full flex flex-row items-center justify-between px-8 py-6 md:px-12 max-w-6xl 2xl:max-w-screen-2xl 2xl:px-32"
        x-data="{ open: false }"
    >
      <div class="items-center flex justify-between flex-row text-white">
        <a
            href="/"
            title="Runic Haversack"
            aria-label="Runic Haversack"
            class="items-center font-bold inline-flex font-serif text-xl"
        >
          Runic Haversack
        </a>
      </div>
      <div class="flex-col items-center flex-grow hidden sm:flex sm:flex-row gap-3 sm:justify-end text-black">
        <a href="https://www.facebook.com/runic.haversack/" title="Facebook" target="_blank" class="bg-white p-1.5 rounded-full">
          <Icon name="fa-brands:facebook-f" class="h-3.5 w-3.5" />
        </a>
        <a href="https://www.instagram.com/Runic.haversack/" title="Instagram" target="_blank" class="bg-white p-1.5 rounded-full">
          <Icon name="fa-brands:instagram" class="h-3.5 w-3.5"/>
        </a>
      </div>
    </div>
  </div>
</footer>
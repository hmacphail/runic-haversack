---
import PhotoSwitcher from "./PhotoSwitcher.astro";

const { title, description, url, images, variations, isMain } = Astro.props;
const price = Number((variations[0].item_variation_data.price_money.amount / 100) ?? 0).toFixed(2);
const componentId = `item-${Math.random().toString(36).substr(2, 9)}`;
---

<!-- Product card container: 2-column grid with image and content -->
<div class={`grid sm:grid-cols-2 p-2 group bg-regal-300 overflow-hidden ${isMain ? 'md:h-[425px]' : ''}`}>
  <!-- Product information section -->
  <div class={`flex flex-col justify-between p-4 relative overflow-hidden h-full group bg-white ${isMain ? '' : 'md:min-h-96'}`}>
    <div>
      <p class="font-medium mt-2 text-regal-400 text-base uppercase text-balance">
        {title}
      </p>
      {price > 0 &&
        <p class="text-xs text-zinc-700">${price} CAD</p>
      }
      </div>

      <div class="gap-12 flex flex-col items-start justify-between relative">
        <p class="text-zinc-400 leading-tight mt-8 text-balance">
          {description}
        </p>
        <a
          href={url}
          title={title}
          class="bg-regal-200 px-4 flex gap-1 items-center py-2.5 h-9 text-sm font-semibold text-black bg-opacity-70 hover:bg-opacity-100"
        >
          View Item
        </a>
    </div>
  </div>
  <!-- Image gallery section with navigation -->
  <PhotoSwitcher 
    images={images} 
    alt={title} 
    componentId={componentId} 
  />
</div>

---
const { images, alt, componentId } = Astro.props;
const hasValidImages = images && images.length > 0 && images[0];
const hasMultipleImages = images && images.length > 1;
---

<div class="bg-regal-50 overflow-hidden order-first relative group/image">
  {/* Main image display */}
  {hasValidImages && (
    <img
      id={`${componentId}-image`}
      class="w-full h-full object-cover transition-opacity duration-300"
      src={images[0]}
      alt={alt}
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
  )}
  
  {/* Image placeholder for missing/broken images */}
  <div 
    id={`${componentId}-placeholder`}
    class={`w-full h-full flex items-center justify-center bg-regal-100 text-regal-400 opacity-40 ${hasValidImages ? 'hidden' : 'flex'}`}
    aria-label={`${alt} - Image not available`}
  >
    <div class="text-center">
      <svg class="w-16 h-16 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <p class="text-sm font-medium">Image not available</p>
    </div>
  </div>
  
  {/* Navigation arrows - only show if multiple images */}
  {hasMultipleImages && (
    <>
      {/* Left arrow */}
      <button
        id={`${componentId}-prev`}
        class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover/image:opacity-100 transition-opacity duration-200 hover:bg-black/40 focus:outline-none focus:ring-2 focus:ring-white/50"
        aria-label="Previous image"
        type="button"
      >
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      {/* Right arrow */}
      <button
        id={`${componentId}-next`}
        class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover/image:opacity-100 transition-opacity duration-200 hover:bg-black/40 focus:outline-none focus:ring-2 focus:ring-white/50"
        aria-label="Next image"
        type="button"
      >
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
      
      {/* Image indicator dots */}
      <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex space-x-1 opacity-0 group-hover/image:opacity-100 transition-opacity duration-200">
        {images.map((_, index) => (
          <button
            id={`${componentId}-dot-${index}`}
            class="w-2 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-colors duration-200 focus:outline-none focus:ring-1 focus:ring-white/50"
            aria-label={`Go to image ${index + 1}`}
            type="button"
          ></button>
        ))}
      </div>
    </>
  )}
</div>

{/* Data attributes for external script initialization */}
{hasMultipleImages && (
  <div 
    data-photo-switcher={componentId}
    data-images={JSON.stringify(images)}
    style="display: none;"
  ></div>
)}

---
import { Icon } from 'astro-icon/components'
const contactItems = [
  {
    icon: "fa-regular:envelope",
    label: "Send us an Email",
    username: "gencelescosplay@gmail.com",
    url: "mailto:gencelescosplay@gmail.com",
  },
  {
    icon: "fa-brands:instagram",
    label: "Message on Instagram",
    username: "@Runic.haversack",
    url: "https://www.instagram.com/Runic.haversack/",
  },
];
---

<section class="bg-regal-100 ">
  <div class="px-8 md:px-12 max-w-6xl mx-auto 2xl:max-w-7xl pb-24">
    <div
      class="grid grid-grid-cols-1 lg:grid-cols-2 justify-between"
    >
      <div class="mt-12 lg:text-left">
        <h2 class="text-regal-800 font-serif text-3xl font-semibold">
          Any questions for us?
        </h2>
        <p class="mt-4 text-lg text-black">
          Reach out and let us know.
        </p>
      </div>
      <div class="mt-12 lg:ml-auto w-full">
        <div class="flex flex-col gap-2">
          {contactItems.map((item) => (
            <a
                href={item.url}
                title={item.label}
                class="flex flex-col bg-white w-full p-6 relative overflow-hidden h-full">
              <div class="flex items-center gap-4 group text-black">
                <span class="border border-gray-400 p-3 rounded-full">
                  <Icon name={item.icon} class="h-4 w-4" />
                </span>
                <div class="text-sm leading-6">
                  <p class="font-medium text-black text-base">
                    {item.label}
                  </p>
                  <p class="text-gray-400 leading-tight">{item.username}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

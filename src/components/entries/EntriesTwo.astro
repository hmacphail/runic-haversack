---
const { title, description, url, images, variations } = Astro.props;
const price = Number(variations[0].item_variation_data.price_money.amount / 100).toFixed(2);
const image = images[0];
---

<a href={url} title={title} aria-label={description} class="group">
  <article class="h-full flex-1">
    <div class="w-full block lg:col-span-2">
      <img
        class="h-full object-cover aspect-[384/246] bg-center"
        src={image}
        alt={title}
      />
    </div>
    <div class="w-full flex flex-col items-start justify-between -mt-20 p-4">
      <div
        class="w-full p-4 lg:p-8 bg-wood-100 h-full flex flex-col justify-between text-balance"
      >
        <div>
          <p class="font-medium text-black uppercase text-xl font-serif">
            {title}
          </p>
          <p class="text-slate-600 line-clamp-2 mt-12 text-sm">
            {description}
          </p>
        </div>
        <div class="items-center inline-flex mt-1 space-x-1">
          <span class="flex text-gray-500 text-xs">
            {price}
          </span>
        </div>
      </div>
    </div>
  </article>
</a>

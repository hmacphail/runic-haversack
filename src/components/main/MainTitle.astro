---
import { getEntry } from "astro:content";
const shop = await getEntry("links", "shop");
---
<section>
    <div class="items-center 2xl:max-w-7xl max-w-6xl md:px-12 mx-auto px-8">
      <div class="border-b pb-4 text-balance">
        <p class="text-regal-600 font-serif text-4xl lg:text-5xl font-semibold">
            Locally crafted equipment and trinkets for all your adventuring needs!
        </p>
        <p class="text-black mt-4 text-lg">
            Shipping and Local Delivery options available
        </p>
        <p class="my-5">
            <a
                href={shop.data.url}
                title={shop.data.title}
                aria-label={shop.data.title}
                class="inline-flex justify-center py-1 px-4 h-10 items-center text-sm font-medium tracking-wide focus:outline-none bg-regal-600 text-white hover:bg-opacity-90 focus-visible:outline-regal-100 disabled:opacity-30"
            >
                {shop.data.title}
            </a>
        </p>
      </div>
    </div>
  </section>